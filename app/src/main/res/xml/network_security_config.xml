<?xml version="1.0" encoding="utf-8"?>
<!-- plan.md §9: semua request domain publik wajib HTTPS; cleartext dilarang.
     Pengecualian: host pengembangan lokal (emulator/debug) agar bisa tes backend lokal. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Host pengembangan lokal (emulator -> host, LAN dev). Domain publik tetap HTTPS. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
